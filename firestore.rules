rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{document} {
      allow read, write: if true;
    }
    match /enquiries/{document} {
      allow read, write: if true;
    }
    match /session_logs/{document} {
      allow read, write: if true;
    }
    match /notices/{document} {
      allow read, write: if true;
    }
    match /family_messages/{document} {
      allow read, write: if true;
    }
    match /gallery_items/{document} {
      allow read, write: if true;
    }
    match /legacy_admissions/{document} {
      allow read, write: if true;
    }
    match /admin_users/{document} {
      allow read, write: if true;
    }
    match /password_resets/{document} {
      allow read, write: if true;
    }
  }
}
